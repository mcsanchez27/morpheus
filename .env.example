# Morpheus Discord Bot Token (from Discord Developer Portal)
MORPHEUS_DISCORD_TOKEN=

# Default LLM Provider: "gemini" | "claude" | "openai"
LLM_PROVIDER=gemini

# Specific Model Overrides (Optional)
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini

# API Keys (the Anthropic API is billed separately from a Claude Max subscription)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Fight Bot integration
# Path to Fight Bot's SQLite court database
FIGHTBOT_DB_PATH=M:/Projects/Matt/Fight Bot/data/court.db
# Optional: Fight Bot's Discord user ID. When set, only cards from this user are
# treated as challenges; otherwise any bot whose name contains "Fight Bot" matches.
FIGHTBOT_USER_ID=

# Target Discord Server (Mountain Man Studios)
DISCORD_GUILD_ID=1560796428161388595
